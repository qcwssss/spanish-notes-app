{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "note-lingo-app",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "vivanote.epubtranslation.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "note-lingo-app"
    }
  ],
  "env": {
    "preview": {
      "name": "note-lingo-app-preview",
      "routes": [
        {
          "pattern": "vivanote-preview.epubtranslation.com",
          "custom_domain": true
        }
      ],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "note-lingo-app-preview"
        }
      ]
    }
  }
}
